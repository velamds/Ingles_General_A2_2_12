ontents": [{"type": "text", "content": ""}]}], "id": 0, "responses": [{"correct": 0, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}, {"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 1, "selected": 0}]}], "stimuli_ids": [], "id": 10, "type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}], "template_override": 1}, {"questions": [{"_data": [{"type": "question", "contents": [{"type": "pdf", "content": "engenn5le12ob08re7pdf01.pdf"}]}], "id": 0, "responses": [{"correct": 1, "_data": [{"type": "text", "content": ""}], "id": 0, "selected": 0}]}], "stimuli_ids": [], "id": 11, "type": "DWS", "_data": [{"type": "instructions", "contents": [{"type": "text", "content": " Relationships can be hard work! Write an apology letter to someone after a bad breakup."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self Assessment."}]}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"id": 0, "_data": [], "template_override": 1, "type": "welcome", "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le12ob08re2aud01", "coverimg": "engenn5le12ob08re2img01.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le12ob08re2img01.jpg"}, {"text": "Dear Vanessa,<br /><br />I wanted to write to you to apologize for my obnoxious and insensitive behavior.<br />The way I acted on our date last night was completely inappropriate. I am ashamed to say that I embarrassed you in public.", "id": 1, "time": "100", "image": "engenn5le12ob08re2img01.jpg"}, {"text": "Come to think of it, making fun of you about the \u201cPicasso\u201d painting and scaring you with the geese were not some of my finer moments either.This is an especially terrible thing for me to do since I know you are terrified of birds. I know that I have hurt you and you deserve better.", "id": 2, "time": "14200", "image": "engenn5le12ob08re2img05.jpg"}, {"text": "You are such an incredible person, I don't want to lose what we have. I hope you can forgive my immaturity so that we can move forward in our relationship. I'm actually a decent guy. I will be on my best behavior when we see your friends next week.\nI promise to make it up to you.\n<br />\n<br />\nMarco", "id": 3, "time": "31300", "image": "engenn5le12ob08re2img01.jpg"}]}}]}, {"id": 2, "type": "video", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "video", "value": {"video_src": "engenn5le12ob08re3vid01", "images": [{"text": "", "id": 0, "time": "0", "image": ""}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa Breaks Up With Marco"}, {"type": "unit_name", "content": "The Apology"}, {"type": "position", "content": 8}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": " Accurately use information about people's jobs and places of work in communicative situations."}, {"type": "secondary_1", "content": " Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_2", "content": " Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_3", "content": " Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_4", "content": " Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_5", "content": " Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_6", "content": " Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_7", "content": " Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}, {"type": "secondary_8", "content": " Writes a brief text about the advantages and disadvantages of specific forms of communication through the appropriate use of grammar, vocabulary, syntaxes and spelling aspects related to this level."}]}, {"type": "background_image", "content": "engenn5le12ob08re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": " An Apology Letter"}, {"type": "describer", "content": " "}, {"type": "text", "content": "<span class =\"strong\">When you write an apology letter, you need to:</span>"}, {"type": "text", "content": "<span class =\"strong\">1.State what your letter is about.  </span>"}, {"type": "text", "content": "<span class=\"italic\">Example: I wanted to write you a letter to apologize. </span>"}, {"type": "text", "content": "<span class =\"strong\">2. State your mistake or poor behavior.  </span>"}, {"type": "text", "content": "Say what you're apologizing for and why it was wrong. You need to be very exact and descriptive. "}, {"type": "text", "content": "<span class=\"italic\">Example: I am sorry for yelling at you. </span>"}, {"type": "text", "content": "<span class =\"strong\">3. Acknowledge how much you hurt the other person. </span>"}, {"type": "text", "content": "Acknowledge that the person was hurt and that you understand how hurtful it was. "}, {"type": "text", "content": "<span class=\"italic\">Example: I embarrassed you in public and that is unforgivable. </span>"}, {"type": "text", "content": "<span class =\"strong\">4. Express your gratitude. </span>"}, {"type": "text", "content": "Shows that you appreciate the person to help show that you really do feel badly about what you've done."}, {"type": "text", "content": "<span class=\"italic\">Example: You are an incredible person. </span>"}, {"type": "text", "content": "<span class =\"strong\">5. Accept responsibility.  </span>"}, {"type": "text", "content": "What you do need to do is admit your responsibility for your mistake. "}, {"type": "text", "content": "<span class=\"italic\">Example: What I did at the restaurant was wrong. </span>"}, {"type": "text", "content": "<span class =\"strong\">6. State a desire to have a better relationship in the future and a promise. </span>"}, {"type": "text", "content": "Express that you would like to move forward and learn from past errors."}, {"type": "text", "content": "<span class=\"italic\">Example: I hope we can move forward from this and look towards the future.</span>"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Making and Responding To Promises"}, {"type": "describer", "content": " "}, {"type": "text", "content": "You use the Future tense to make promises."}, {"type": "text", "content": "Often the moment the event will happen is unknown. "}, {"type": "text", "content": "This tense is often used with the following time expressions:<br /><br/>soon, next month, next week"}, {"type": "text", "content": "<span class =\"strong\">Positive</span>"}, {"type": "text", "content": "<span class=\"italic\">Subject + will + verb + object(s) + time Expression </span>"}, {"type": "text", "content": "<span class=\"italic\">Example: I will be on my best behavior when we see your friends next week. </span>"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "insensitive"}, {"type": "definition", "content": "showing that you do not know or care about the feelings of other people "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I apologize for my insensitive behavior."}, {"type": "audio", "content": "engenn5le12ob08aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words you use in an apology letter."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "immaturity"}, {"type": "definition", "content": "to acting in a childish way "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I showed a lot of immaturity"}, {"type": "audio", "content": "engenn5le12ob08aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "finer"}, {"type": "definition", "content": "good, acceptable, or satisfactory "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I was not one of my finer moments."}, {"type": "audio", "content": "engenn5le12ob08aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "ashamed "}, {"type": "definition", "content": "feeling shame or guilt "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You were so ashamed of me."}, {"type": "audio", "content": "engenn5le12ob08aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "come to think of it "}, {"type": "definition", "content": "when I think back"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Come to think of it, I embarrassed you last week too."}, {"type": "audio", "content": "engenn5le12ob08aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "decent"}, {"type": "definition", "content": "polite, moral, and honest "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I'm actually a pretty decent guy."}, {"type": "audio", "content": "engenn5le12ob08aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "gratitude"}, {"type": "definition", "content": "feeling of appreciation or thanks "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: I wanted to express my gratitude."}, {"type": "audio", "content": "engenn5le12ob08aud07"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Write an apology letter."}, {"type": "text", "content": "Include a greeting and a closing."}, {"type": "text", "content": "Write a statement about why you are writing a letter."}, {"type": "text", "content": "Include the mistakes made."}, {"type": "text", "content": "Acknowledge that you hurt others."}, {"type": "text", "content": "Express gratitude."}, {"type": "text", "content": "Accept responsibility for your actions."}, {"type": "text", "content": "Make a promise."}, {"type": "text", "content": "Read your letter aloud to a partner or family member."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write an apology letter to someone I care about."}, {"type": "text", "content": "I use a greeting and closing in a letter."}, {"type": "text", "content": "I write a structured letter to express my feelings."}, {"type": "text", "content": "I proofread my work."}, {"type": "text", "content": "I read my apology letter aloud."}]}], "type": "sena"}