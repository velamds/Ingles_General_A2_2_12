[{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0, "responses": [{"correct": 0, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}, {"correct": 1, "id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0}]}]}, {"id": 11, "template_override": 1, "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"content": " Relationships can be hard work! Write an apology letter to someone after a bad breakup.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "type": "DWS", "questions": [{"_data": [{"type": "question", "contents": [{"content": "engenn5le12ob08re7pdf01.pdf", "type": "pdf"}]}], "id": 0, "responses": [{"correct": 1, "id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0}]}]}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "id": 0, "template_override": 1}, {"id": 1, "contents": [{"value": {"audiosrc": "engenn5le12ob08re2aud01", "images": [{"image": "engenn5le12ob08re2img01.jpg", "id": 0, "text": "", "time": "0"}, {"image": "engenn5le12ob08re2img01.jpg", "id": 1, "text": "Dear Vanessa,<br /><br />I wanted to write to you to apologize for my obnoxious and insensitive behavior.<br />The way I acted on our date last night was completely inappropriate. I am ashamed to say that I embarrassed you in public.", "time": "100"}, {"image": "engenn5le12ob08re2img05.jpg", "id": 2, "text": "Come to think of it, making fun of you about the \u201cPicasso\u201d painting and scaring you with the geese were not some of my finer moments either. This is an especially terrible thing for me to do since I know you are terrified of birds. I know that I have hurt you and you deserve better.", "time": "14200"}, {"image": "engenn5le12ob08re2img01.jpg", "id": 3, "text": "You are such an incredible person, I don't want to lose what we have. I hope you can forgive my immaturity so that we can move forward in our relationship. I'm actually a decent guy. I will be on my best behavior when we see your friends next week.\nI promise to make it up to you.\n<br />\n<br />\nMarco", "time": "31300"}], "coverimg": "engenn5le12ob08re2img01.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "title": ""}, {"id": 2, "contents": [{"value": {"images": [{"image": "", "id": 0, "text": "", "time": "0"}, {"image": "", "id": 1, "text": "An Apology Letter", "time": "5000"}, {"image": "", "id": 2, "text": "<span class=\"bullet\">state what the letter is about", "time": "20000"}, {"image": "", "id": 3, "text": "<span class=\"bullet\">state your mistake or poor behavior", "time": "33000"}, {"image": "", "id": 4, "text": "<span class=\"bullet\">acknowledge how much you hurt the other person", "time": "51000"}, {"image": "", "id": 5, "text": "<span class=\"bullet\">express your gratitude", "time": "67000"}, {"image": "", "id": 6, "text": "<span class=\"bullet\">accept responsibility", "time": "86000"}, {"image": "", "id": 7, "text": "<span class=\"bullet\">express that you would like to move forward", "time": "97000"}], "video_src": "engenn5le12ob08re3vid01"}, "type": "video"}], "template_override": 1, "_data": [], "type": "video", "title": ""}], "id": 0, "type": "scholar", "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true,