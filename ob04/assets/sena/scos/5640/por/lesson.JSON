ected": 0, "id": 1}]}], "stimuli_ids": [], "id": 11, "type": "RSLT", "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}], "template_override": 1}], "id": 0, "type": "scholar", "stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "id": 0, "contents": [{}]}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le12ob04re2aud01", "coverimg": "engenn5le12ob04re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le12ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: What happened after your phone died? <br>\n<span class=\"strong\">Vanessa</span>: Things went from bad to worse.<br>\n<span class=\"strong\">Sally</span>: How? <br>\n<span class=\"strong\">Vanessa</span>: He started arguing with the police officer.<br>\n<span class=\"strong\">Sally</span>: Really? Why?<br>\n<span class=\"strong\">Vanessa</span>: The police officer couldn't say his name properly. He kept calling him Mark or Markus.<br>", "id": 1, "time": "100", "image": "engenn5le12ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: He does have a strong accent and he was slurring ... right?<br>\n<span class=\"strong\">Vanessa</span>: Yeah, it was embarrassing. I just looked down at my feet the whole time.<br>\n<span class=\"strong\">Sally</span>: How did the night end?<br>\n<span class=\"strong\">Vanessa</span>: The officer took his driver's license and told him to collect it from the station in the morning.<br>", "id": 2, "time": "14400", "image": "engenn5le12ob04re2img01.jpg"}, {"text": "<span class=\"strong\">Sally</span>: How did you get home?<br>\n<span class=\"strong\">Vanessa</span>: We had to walk up Hillier street and across the bridge in the dark.<br>\n<span class=\"strong\">Sally</span>: You walked all the way home? What a nightmare!<br>\n<span class=\"strong\">Vanessa</span>: Let's meet up when you get back. You should see the photos!<br>", "id": 3, "time": "29500", "image": "engenn5le12ob04re2img05.jpg"}]}}]}]}], "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa Breaks Up With Marco"}, {"type": "unit_name", "content": "It's All a Mistake"}, {"type": "position", "content": 4}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about people's jobs and places of work in communicative situations."}, {"type": "secondary_1", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_3", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_5", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}]}, {"type": "background_image", "content": "engenn5le12ob04re1img01.png"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Sentence Stress"}, {"type": "describer", "content": " "}, {"type": "text", "content": "Sentence stress gives English its <span class=\"strong\">rhythm</span> or \"beat\". "}, {"type": "text", "content": "Word stress is accent on <span class=\"strong\">one syllable</span> within a <span class=\"strong\">word</span>."}, {"type": "text", "content": "Sentence stress is emphasis on <span class=\"strong\">certain words</span> within a <span class=\"strong\">sentence</span>."}, {"type": "text", "content": "Most sentences have two basic types of words:"}, {"type": "text", "content": "<span class=\"strong\">Content Words</span> <ul><li> Content words are the important or key words of a sentence. They provide the meaning of the sentence.</li>"}, {"type": "text", "content": "<span class=\"strong\">Structure Words </span>  <ul><li>Structure words are not important words. They are small words that you use to make the sentence correct. </li>"}, {"type": "example", "content": "He started <span class = \"strong\">arguing </span>with the <span class = \"strong\">police officer.</span>"}, {"type": "example", "content": "<span class = \"strong\">What</span> a <span class = \"strong\">nightmare!</span>"}, {"type": "example", "content": "You should <span class = \"strong\"> see</span> the <span class = \"strong\">photos.</span>"}, {"type": "example", "content": " <span class = \"strong\">Things</span> went from <span class = \"strong\"> bad</span> to  <span class = \"strong\">worse.</span>"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These words you use when you have problems."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "sergeant "}, {"type": "definition", "content": "an officer in a police force with a rank below captain"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Marco had to get his driver's license from the sergeant in the morning."}, {"type": "audio", "content": "engenn5le12ob04aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to make it home"}, {"type": "definition", "content": "to arrive home safely"}, {"type": "part_speech", "content": " (expression)"}, {"type": "example", "content": "Example: How did you make it home that night?"}, {"type": "audio", "content": "engenn5le12ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "all the way"}, {"type": "definition", "content": "the entire distance"}, {"type": "part_speech", "content": " (expression)"}, {"type": "example", "content": "Example: We had to walk all the way home."}, {"type": "audio", "content": "engenn5le12ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "from bad to worse"}, {"type": "definition", "content": "a negative situation that does not improve"}, {"type": "part_speech", "content": " (expression)"}, {"type": "example", "content": "Example: The evening went from bad to worse."}, {"type": "audio", "content": "engenn5le12ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to collect "}, {"type": "definition", "content": "to get things from different places"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: He has to collect his license from the police station."}, {"type": "audio", "content": "engenn5le12ob04aud05"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Go online and find 15 words that are spelled with the double <span class=\"italic\">ee</span>. Make a list."}, {"type": "text", "content": "With a partner, create a 3 minute role play on what happened on Marco and Vanessa's date."}, {"type": "text", "content": "Use at least 5 words that have a double <span class=\"italic\">ee</span> in the conversation."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I can use the Internet to find new words to use in conversations."}, {"type": "text", "content": "I create a 3 minute role play about a date."}, {"type": "text", "content": "I role play with a partner."}]}], "type": "sena"}