{"_data": [{"contents": [{"content": "Vanessa Breaks up With Marco", "type": "lesson_name"}, {"content": "Starting Over", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 12, "type": "lesson"}, {"content": "A2.2", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_4"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}], "type": "objectives"}, {"content": "engenn5le12ob07re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "The Past Continuous Tense", "type": "heading"}, {"content": " You use the Past Continuous tense to talk about something that was happening at a particular time in the past.", "type": "describer"}, {"content": "You often use the Simple Past together with the Past Continuous tense.  ", "type": "text"}, {"content": "It is important to remember how to use the comma (,) between these two clauses.", "type": "text"}, {"content": "You use a comma after the <span class=\"strong\">while</span> or <span class=\"strong\">when</span> clause when it is at the beginning of the sentence.", "type": "text"}, {"content": "While he was apologizing, he held my hand and looked into my eyes.", "type": "example"}, {"content": "When I saw your e-mail, I was walking around the park.", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "to remind", "type": "name"}, {"content": "to cause someone to remember something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: It reminded me of your story.", "type": "example"}, {"content": "engenn5le12ob07aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " These are words you use to describe people.", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "sweet", "type": "name"}, {"content": "kind; nice", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: You're so sweet to worry about me.", "type": "example"}, {"content": "engenn5le12ob07aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "unpredictable", "type": "name"}, {"content": "not easy to predict; cannot see the future behavior", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He is a little unpredictable.", "type": "example"}, {"content": "engenn5le12ob07aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "ridiculous", "type": "name"}, {"content": "silly; funny; absurd", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He realizes how ridiculous he was.", "type": "example"}, {"content": "engenn5le12ob07aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to apologize", "type": "name"}, {"content": "to express regret about something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: He apologized for his bad behavior. ", "type": "example"}, {"content": "engenn5le12ob07aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "forgiving", "type": "name"}, {"content": "soft-hearted; ready to forgive people", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Maybe I'm too forgiving.", "type": "example"}, {"content": "engenn5le12ob07aud06", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "flaw ", "type": "name"}, {"content": "an imperfection; a mistake ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Everyone has character flaws.", "type": "example"}, {"content": "engenn5le12ob07aud07", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to make up", "type": "name"}, {"content": "to be friends again after an argument", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Marco and I made up.", "type": "example"}, {"content": "engenn5le12ob07aud08", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "Imagine you are worried about your friend.", "type": "text"}, {"content": "Write an e-mail (8-10 sentences) to them.", "type": "text"}, {"content": "Write about what you were doing and ask them what they are doing.", "type": "text"}, {"content": "Give or send the e-mail to your friend and ask them to write back.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I write 8-10 sentences.", "type": "text"}, {"content": "I use the Past Continuous tense.", "type": "text"}, {"content": "I use adjectives.", "type": "text"}, {"content": "I give the e-mail to my friend.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn5le12ob07re2aud01", "images": [{"image": "engenn5le12ob07re2img05.jpg", "id": 0, "time": "0", "text": ""}, {"image": "engenn5le12ob07re2img05.jpg", "id": 1, "time": "100", "text": "<span class=\"strong\">Sally</span>: Hi, V. The last time I heard from you, you and Marco were questioned by the cops! Where are you? Is everything OK? While I was walking down the street, I saw some police. It reminded me of you and your story. I have to know what's going on! Write back soon, please!"}, {"image": "engenn5le12ob07re2img06.jpg", "id": 2, "time": "18000", "text": "<span class=\"strong\">Vanessa</span>: Hey, Sal! You're so sweet to worry about me! Everything is fine with me and Marco. We made up. He's a little unpredictable, but I kind of like that about him. He also realizes how ridiculous he was when we were out for dinner. He apologized and promised me he won't behave like that again. Everyone has character flaws. Maybe mine is that I'm too forgiving.\nWhat do you think? How is your trip going, by the way? Where are you now?"}], "coverimg": "engenn5le12ob07re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "id": 1}], "exercises": [{"id": 0, "stimuli_ids": [0], "template_override": 1, "_data": [{"contents": [{"content": " I can talk about p