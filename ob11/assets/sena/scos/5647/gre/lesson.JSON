{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa Breaks Up With Marco"}, {"type": "unit_name", "content": "Everything Is Fine"}, {"type": "position", "content": 11}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 12}, {"type": "level", "content": "A2.2"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Identify and describe plans for the organization of events."}, {"type": "secondary_1", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_3", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_4", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_5", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_6", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_7", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level."}]}, {"type": "background_image", "content": "engenn5le12ob11re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Talking About Possible Events in the Future"}, {"type": "describer", "content": "You use the Future tense (<span class=\"strong\">will</span>) to talk about actions in the future. You can also use the modals <span class=\"strong\">might </span> and <span class=\"strong\">may </span> to talk about possible actions in the future."}, {"type": "text", "content": "The auxiliary <span class=\"strong\">will </span> goes before the verb. The short form is \u2018ll."}, {"type": "text", "content": "You use the Future tense when you talk about the future, make offers or make predictions."}, {"type": "text", "content": "The modals <span class=\"strong\">might </span> and <span class=\"strong\">may </span> go before the verb. "}, {"type": "text", "content": "They talk about future possibility or chance that something will happen. <br><span class=\"strong\">Might </span> means there is a smaller chance that something will happen (30%). <br><span class=\"strong\">May </span> means there is a slightly greater chance that something will happen (50%)."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Past Continuous Tense"}, {"type": "describer", "content": "You use the Past Continuous Tense to talk about an action that was happening in the past"}, {"type": "text", "content": "You often use the Past Continuous tense and the Simple Past tense together in a sentence."}, {"type": "text", "content": "You use both of these tenses to talk about an action that interrupted another action."}, {"type": "text", "content": "For example:"}, {"type": "text", "content": "When you <span class=\"strong\">rang </span >(SIMPLE PAST) I <span class=\"strong\">was getting</span> ready to leave. (PAST CONTINUOUS)."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cops"}, {"type": "definition", "content": "casual word for police "}, {"type": "part_speech", "content": " (noun)"}, {"type": "example", "content": "Example: The cops came and interviewed us."}, {"type": "audio", "content": "engenn5le12ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words to review."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to show up "}, {"type": "definition", "content": "to appear "}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: The cops showed up."}, {"type": "audio", "content": "engenn5le12ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "jerk "}, {"type": "definition", "content": "a rude person "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: He is such a jerk!"}, {"type": "audio", "content": "engenn5le12ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "obnoxious"}, {"type": "definition", "content": " loud and rude "}, {"type": "part_speech", "content": " (adjective)"}, {"type": "example", "content": "Example: He was very obnoxious at the restaurant."}, {"type": "audio", "content": "engenn5le12ob11aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to yell"}, {"type": "definition", "content": "to talk very loudly at someone "}, {"type": "part_speech", "content": " (verb)"}, {"type": "example", "content": "Example: He was yelling at his ex-girlfriend."}, {"type": "audio", "content": "engenn5le12ob11aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "forgiving "}, {"type": "definition", "content": "softhearted; ready to forgive people"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": " Example: Maybe I'm too forgiving."}, {"type": "audio", "content": "engenn5le12ob11aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "flaw "}, {"type": "definition", "content": "an imperfection; a mistake"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": " Example: Everyone has character flaws."}, {"type": "audio", "content": "engenn5le12ob11aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to make up"}, {"type": "definition", "content": " to be friends again after an argument "}, {"type": "part_speech", "content": " (verb)"}, {"type": "example", "content": "Example: Marco and I made up."}, {"type": "audio", "content": "engenn5le12ob11aud08"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": " Form a group of six people. "}, {"type": "text", "content": "The first person thinks of a Past Continuous and Past tense sentence. "}, {"type": "text", "content": "The first person whispers (says it VERY quietly) to the second person, who then whispers it to the next person etc."}, {"type": "text", "content": "The last person says the sentence out loud. "}, {"type": "text", "content": "Is is the same as the original sentence? "}, {"type": "text", "content": "Play it 6 times so everyone has a chance to think of a sentence."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I think of sentences in the Past Continuous and Past tenses."}, {"type": "text", "content": "I whisper it to the next person."}, {"type": "text", "content": "I say the sentence out loud."}]}], "labs": [{"stimuli": [{"_data": [], "template_override": 1, "type": "welcome", "contents": [{}], "id": 0}, {"id": 1, "type": "audio", "title": "", "_data": [], "template_override": 1, "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn5le12ob11re2aud01", "coverimg": "engenn5le12ob11re2img05.jpg", "images": [{"text": "", "id": 0, "time": "0", "image": "engenn5le12ob11re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Hi, Peter! Long time no see!<br>\n<span class=\"strong\">Peter</span>: Hi, Sally. Yeah, how are you? <br>\n<span class=\"strong\">Sally</span>: I'm great ... I might be coming home soon! How are you?<br>\n<span class=\"strong\">Peter</span>: I'm okay ... really busy with work and school ... I feel like I'm being stretched too thin these days.", "id": 1, "time": "100", "image": "engenn5le12ob11re2img05.jpg"}, {"text": "<span class=\"strong\">Sally</span>: Oh no! I'm sorry to hear that ... Did you hear about what happened with Vanessa and Marco?<br>\n<span class=\"strong\">Peter</span>: Not really. I heard they had a fight while they were eating out.<br>\n<span class=\"strong\">Sally</span>: That's right! Marco was behaving like a jerk, being obnoxious and weird. They ran into his ex-girlfriend and he was yelling at her on the street when the cops showed up!", "id": 2, "time": "14100", "image": "engenn5le12ob11re2img07.jpg"}, {"text": "<span class=\"strong\">Peter</span>: Did they make up?<br>\n<span class=\"strong\">Sally</span>: Kind of. Vanessa might forgive him ...<br>\n<span class=\"strong\">Peter</span>: That's her flaw - she's too forgiving! I may call her later today.", "id": 3, "time": "34700", "image": "engenn5le12ob11re2img06.jpg"}, {"text": "<span class=\"strong\">Sally</span>: That's a good idea. Well, good luck at school! I'll talk to you later!<br>\n<span class=\"strong\">Peter</span>: Thanks! Take care!", "id": 4, "time": "43500", "image": "engenn5le12ob11re2img05.jpg"}]}}]}], "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0, "type": "scholar", "exercises": [{"questions": [], "stimuli_ids": [0], "id": 0, "type": "WLC", "img_path": "", "_data": [{"type": "instructions", "contents": [{"type": "Learning Outcomes", "content": " I can say what I was doing when something else happened. "}, {"type": "Learning Outco