evment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Describe characteristics of different people and their jobs.", "type": "primary"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_2"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_3"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_4"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_5"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_6"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_7"}, {"content": "Understands important information and aspects of attitude and intention in spoken situations in English on a range of common communicative topics related to this level.", "type": "secondary_8"}]}, {"content": "engenn5le12ob01re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": "The Simple Past Tense", "type": "heading"}, {"content": "You use the Simple Past tense to talk about:<p> <ul> <li>actions or events that happened at a specific time in the past</li> <li>finished events in the past</li></ul> You use the Simple Past to tell a story and report about actions, events and people.", "type": "describer"}, {"content": "I'm so happy I caught you!", "type": "example"}, {"content": "We got in his car and drove to a restaurant.", "type": "example"}, {"content": "He took me to a movie.", "type": "example"}, {"content": "There are regular and irregular verbs.</p> You need to change the spelling of irregular verbs to make them Past tense.</p> Here are some examples: ", "type": "text"}, {"content": "{\"rows\":9,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Irregular Verb\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Past Tense\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"catch\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"caught\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"ring\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"rang\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"take\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"took\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"think\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"thought\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"leave\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"left\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"have\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"had\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"get\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"got\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"drive\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"drove\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}]}, {"type": "learning_points", "contents": [{"content": "The Past Continuous Tense", "type": "heading"}, {"content": "You use the Past Continuous Tense to talk about an action that was happening in the past. ", "type": "describer"}, {"content": "You often use the Past Continuous tense and the Simple Past tense together in a sentence.", "type": "text"}, {"content": "You use both of these tenses to talk about an action that interrupted another action.", "type": "text"}, {"content": "For example:</p> When you <span class=\"strong\">rang</span> (SIMPLE PAST) I <span class=\"strong\">was getting</span> ready to leave (PAST CONTINUOUS).", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "fake", "type": "name"}, {"content": "not real; not true", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He is so fake!", "type": "example"}, {"content": "engenn5le12ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": "These are words you use to describe people.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "repulsive", "type": "name"}, {"content": "disgusting; very unpleasant", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The movie was repulsive.", "type": "example"}, {"content": "engenn5le12ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "aloof", "type": "name"}, {"content": "unfriendly; uncaring; distant", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He became aloof after the movie.", "type": "example"}, {"content": "engenn5le12ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "quiet", "type": "name"}, {"content": "not talking; distant", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He became quiet and aloof.", "type": "example"}, {"content": "engenn5le12ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "weird", "type": "name"}, {"content": "strange; odd", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The date was really weird.", "type": "example"}, {"content": "engenn5le12ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "trendy", "type": "name"}, {"content": "very fashionable", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: We went to a trendy restaurant.", "type": "example"}, {"content": "engenn5le12ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "nightmare", "type": "name"}, {"content": "a very bad dream", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I had a nightmare about our date.", "type": "example"}, {"content": "engenn5le12ob01aud07", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Write a short paragraph (8-10 lines) about a nightmare experience you had. Write about a date, a trip or a moment at work or school.", "type": "text"}, {"content": "Use adjectives.", "type": "text"}, {"content": "Use the Simple Past and Past Continuous tenses.", "type": "text"}, {"content": "Read your paragraph to your partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I use the Simple Past and Past Continuous tenses.", "type": "text"}, {"content": "I write 8-10 lines about my nightmare experience.", "type": "text"}, {"content": "I use adjectives to describe things and feelings.", "type": "text"}]}]}